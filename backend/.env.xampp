# One Click School Solutions — घरच्या XAMPP साठी ready-made settings
# घरी हे file वापरण्यासाठी: याचं नाव बदलून `.env` करा (backend folder मध्येच)
# आणि DB_PASSWORD मध्ये तुमचा MySQL password टाका (XAMPP मध्ये सहसा रिकामा असतो)

DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=certifypro

PORT=3001

SESSION_SECRET=change-this-to-a-long-random-secret

FRONTEND_URL=http://localhost:3000
