    USERS ||--o{ REFRESH_TOKENS : "holds"
    USERS ||--o{ NOTIFICATIONS : "receives"
    USERS ||--o{ AUDIT_LOGS : "performs"
    USERS ||--o{ USERS : "creates"

    DISTRIBUTORS ||--o{ SCHOOLS : "manages"

    SCHOOLS ||--|| WALLETS : "has one"
    SCHOOLS ||--o{ STUDENTS : "enrolls"
