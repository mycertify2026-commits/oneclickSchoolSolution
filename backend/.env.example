# ===== CertifyPro backend configuration =====

# --- Database ---
# For local XAMPP/WAMP MySQL, uncomment these:
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=certifypro

# For PostgreSQL (Replit) leave DB_TYPE unset; DATABASE_URL is provided automatically.

# --- Server ---
PORT=3001

# --- Auth ---
SESSION_SECRET=change-me-to-a-long-random-string

# --- Email (required for password reset, notifications, and cart OTP) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=youremail@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_PASS is also supported for compatibility with older local .env files.
# EMAIL_FROM_NAME=CertifyPro
# EMAIL_FROM_ADDRESS=youremail@gmail.com

# --- Frontend URL used in email links (optional) ---
# FRONTEND_URL=http://localhost:3000
